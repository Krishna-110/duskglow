# Brevo transactional email — powers the discovery-call form.
# Create a key at https://app.brevo.com/settings/keys/api
# Server-side only: never prefix these with NEXT_PUBLIC_, or the key ships
# to the browser and anyone can send mail as you.
BREVO_API_KEY=

# Where booking requests land. Any inbox you actually read.
BOOKING_TO_EMAIL=

# The From address. Must be a sender Brevo has verified, or sends are rejected.
BOOKING_FROM_EMAIL=hello@duskglow.site
